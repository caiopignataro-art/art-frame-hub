# Provedor de banco de dados ativo no servidor ("supabase" | "postgresql")
DATABASE_PROVIDER=supabase

# Exige autenticação obrigatória nas rotas e Server Functions ("true" | "false")
AUTH_REQUIRED=true

# Configuração Server-Side do Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Configuração Client-Side (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Necessária SOMENTE no servidor para operações administrativas específicas
# que dependam da Supabase Admin API (convite/provisionamento automático de credenciais).
# NUNCA prefixe esta variável com VITE_.
SUPABASE_SERVICE_ROLE_KEY=
