# Provedor de banco de dados ativo no servidor ("supabase" | "postgresql")
DATABASE_PROVIDER=supabase

# Exige autenticação obrigatória nas rotas e Server Functions ("true" | "false")
AUTH_REQUIRED=true

# Configuração Server-Side do Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Configuração Client-Side (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Necessária SOMENTE no servidor para operações administrativas privilegiadas:
# - Bootstrap controlado do primeiro administrador (RPC `bootstrap_first_admin` via service_role)
# - Provisionamento/convite automático de credenciais na Admin API (`auth.admin.*`)
# NUNCA prefixe esta variável com VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo de uso único (mínimo 16 caracteres) exigido no servidor para autorizar o
# provisionamento do primeiro administrador em `provisionFirstAdminServerFn`.
# REMOVA ou rotacione imediatamente após concluir o bootstrap inicial.
# NUNCA prefixe esta variável com VITE_.
FIRST_ADMIN_BOOTSTRAP_SECRET=

# Opcional: restringe qual e-mail autenticado pode executar o bootstrap inicial.
# FIRST_ADMIN_EMAIL=admin@empresa.com.br
